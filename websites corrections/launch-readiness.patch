+
+describe('launch readiness', () => {
+  it('no fabricated traction statistics anywhere', () => {
+    const home = read('src/pages/Home.tsx');
+    // The values themselves, not the explanatory comment.
+    expect(home).not.toMatch(/value: '500\+'/);
