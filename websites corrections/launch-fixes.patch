diff --git a/src/components/InstallPrompt.tsx b/src/components/InstallPrompt.tsx
new file mode 100644
index 0000000..ef458cb
--- /dev/null
+++ b/src/components/InstallPrompt.tsx
@@ -0,0 +1,87 @@
+import { useEffect, useState } from 'react';
+import { Download, X } from 'lucide-react';
+
+/**
+ * "Install MemoryGlen" — a visible button.
+ *
+ * Chrome fires `beforeinstallprompt` when a site meets the install criteria,
+ * but on most Android phones it no longer surfaces a visible prompt on its own;
+ * the option is buried in the ⋮ menu, where nobody looks. Capturing the event
+ * and offering our own button is the supported way to make it discoverable.
+ *
+ * Shows only when Chrome has confirmed the site is installable, so it can never
+ * appear as a button that does nothing. Hidden once installed, and dismissible.
+ */
+
+interface BeforeInstallPromptEvent extends Event {
+  prompt: () => Promise<void>;
+  userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
+}
+
+export default function InstallPrompt() {
+  const [deferred, setDeferred] = useState<BeforeInstallPromptEvent | null>(null);
+  const [dismissed, setDismissed] = useState(false);
+
+  useEffect(() => {
+    const onPrompt = (e: Event) => {
+      e.preventDefault(); // stop Chrome's own mini-infobar
+      setDeferred(e as BeforeInstallPromptEvent);
+    };
+    const onInstalled = () => setDeferred(null);
+    window.addEventListener('beforeinstallprompt', onPrompt);
+    window.addEventListener('appinstalled', onInstalled);
+    return () => {
+      window.removeEventListener('beforeinstallprompt', onPrompt);
+      window.removeEventListener('appinstalled', onInstalled);
+    };
+  }, []);
+
+  // Already running as an installed app.
+  const standalone =
+    typeof window !== 'undefined' &&
+    (window.matchMedia?.('(display-mode: standalone)').matches ||
+      (window.navigator as { standalone?: boolean }).standalone === true);
+
+  if (!deferred || dismissed || standalone) return null;
+
+  return (
+    <div className="fixed inset-x-4 bottom-4 z-[60] mx-auto max-w-sm rounded-sm border border-brass bg-forest-deep p-4 shadow-raised sm:left-auto sm:right-4">
+      <div className="flex items-start gap-3">
+        <Download size={18} className="mt-0.5 flex-none text-brass" aria-hidden />
+        <div className="min-w-0 flex-1">
+          <p className="font-display text-base text-bone">Install MemoryGlen</p>
+          <p className="mt-1 text-sm leading-relaxed text-sage">
+            Keep it on your home screen, and open memorials straight from your phone.
+          </p>
+          <div className="mt-3 flex gap-3">
+            <button
+              type="button"
+              onClick={() => {
+                void deferred.prompt();
+                void deferred.userChoice.finally(() => setDeferred(null));
+              }}
+              className="btn btn-evergreen !min-h-11 px-4 py-2 text-sm"
+            >
+              Install
+            </button>
+            <button
+              type="button"
+              onClick={() => setDismissed(true)}
+              className="min-h-11 px-2 text-sm text-sage transition-colors hover:text-bone"
+            >
+              Not now
+            </button>
+          </div>
+        </div>
+        <button
+          type="button"
+          onClick={() => setDismissed(true)}
+          aria-label="Dismiss install prompt"
+          className="flex h-11 w-11 flex-none items-center justify-center text-sage transition-colors hover:text-bone"
+        >
+          <X size={16} aria-hidden />
+        </button>
+      </div>
+    </div>
+  );
+}
