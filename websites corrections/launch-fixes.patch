+/**
+ * Diagnose a misconfigured key at startup.
+ *
+ * Supabase answers a wrong key with a bare "Invalid API key", which tells a
+ * user nothing and tells the operator nothing either. The anon key is a JWT
+ * carrying its own project ref, so we can check it against the URL and say
+ * exactly what is wrong instead.
+ *
+ * Safe to run in the browser: the anon key is public by design, and this logs
+ * only structural facts, never the key itself.
+ */
+function describeKeyProblem(u: string, k: string): string | null {
+  if (/\s/.test(k)) return 'the key contains a space or line break — re-copy it with no trailing newline';
+  if (k.startsWith('http')) return 'the KEY field contains a URL — the URL and key values look swapped';
+  if (u.includes('eyJ')) return 'the URL field contains a key — the URL and key values look swapped';
+
+  const parts = k.split('.');
+  if (parts.length !== 3) return 'the key is not a complete JWT — it looks truncated; it should be roughly 200+ characters';
+
+  try {
+    const pad = (x: string) => x + '='.repeat((4 - (x.length % 4)) % 4);
+    const payload = JSON.parse(atob(pad(parts[1].replace(/-/g, '+').replace(/_/g, '/'))));
+    const urlRef = new URL(u).hostname.split('.')[0];
+    if (payload.ref && payload.ref !== urlRef) {
+      return `the key belongs to project "${payload.ref}" but the URL points at "${urlRef}" — they are from different Supabase projects`;
+    }
+    if (payload.role && payload.role !== 'anon') {
+      return `the key has role "${payload.role}", not "anon" — use the anon public key, never the service_role key`;
+    }
+    if (payload.exp && Date.now() / 1000 > payload.exp) return 'the key has expired';
+  } catch {
+    return 'the key could not be decoded — it is probably truncated or corrupted';
+  }
+  return null;
+}
+
+if (isSupabaseConfigured) {
+  const problem = describeKeyProblem(url as string, anonKey as string);
+  if (problem) {
+    console.error(
+      `[MemoryGlen] Supabase is misconfigured: ${problem}.\n` +
+        'Fix VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in Vercel → Settings → ' +
+        'Environment Variables, then REDEPLOY (they are baked in at build time).',
+    );
+  }
+}
+
 if (!isSupabaseConfigured && import.meta.env.DEV) {
   console.warn(
     '[MemoryGlen] Supabase is not configured. Copy .env.example to .env and fill it in. ' +
