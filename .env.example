# MemoryGlen — copy to .env and fill in.
#
# NOTE: Vite inlines every VITE_* variable into the JavaScript bundle at build
# time. These are NOT secrets and will be visible to anyone who views source.
# That is expected and safe for the Supabase anon key, but ONLY because Row
# Level Security is enabled on every table — see supabase/migrations/.
#
# The service_role key must NEVER appear here or anywhere in this repo.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
