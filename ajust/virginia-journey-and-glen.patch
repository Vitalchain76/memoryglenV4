+                    {s.kinship ? `${s.kinship} · ` : ''}
+                    {s.birthYear ? `${s.birthYear}\u2013${s.deathYear}` : `d. ${s.deathYear}`}
+                  </span>
+                </li>
+              ))}
+            </ul>
+          </div>
+        </Reveal>
+      )}
+    </div>
+  );
+}
